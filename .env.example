# Server-only secrets — never expose to the client bundle.
# Copy to .env.local for local development; set in Vercel project settings for prod.

# Required for the password gate (every route gates through it). Set this
# BEFORE first dev run — without it, even / and /gate are blocked by the
# proxy with a 503.
DEMO_PASSWORD=change-me

# Required for: /interview on OpenAI, /translator (always — OpenAI-only),
# /api/translate?provider=openai, and the OpenAI badge in settings/env-check.
# Leaving this unset is OK if you only want to exercise the Gemini routes
# during dev — the OpenAI-bound routes will return 503 with `missing_env`.
OPENAI_API_KEY=sk-...

# Required for: /interview on Gemini, /api/translate?provider=gemini, and
# the Gemini badge in settings/env-check.
# Leaving this unset is OK if you only want to exercise the OpenAI routes —
# the Gemini-bound routes will return 503 with `missing_env`.
# NOTE: Gemini has no ephemeral-token concept — the raw key is shipped to
# the browser after the gate password check. Use a dedicated low-quota key
# and rotate weekly. See research/gemini-live-api.md for the trade-off.
GOOGLE_AI_STUDIO_KEY=AIza...
