# Server-only secrets — never expose to the client bundle.
# Copy to .env.local for local development; set in Vercel project settings for prod.

# OpenAI API key with access to the Realtime API.
OPENAI_API_KEY=sk-...

# Google AI Studio API key with access to the Gemini Live API (bidiGenerateContent).
# NOTE: Gemini has no ephemeral-token concept — the raw key is shipped to the
# browser after the gate password check. Use a dedicated low-quota key and
# rotate weekly. See research/gemini-live-api.md for the trade-off discussion.
GOOGLE_AI_STUDIO_KEY=AIza...

# Single password that gates the entire demo (cookie set after correct entry,
# 24h TTL). Rotate to invalidate all outstanding sessions.
DEMO_PASSWORD=change-me
